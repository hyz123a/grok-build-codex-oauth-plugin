{
  "description": "Start the Codex OAuth loopback proxy when a Grok session starts.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${GROK_PLUGIN_ROOT}/scripts/grok-codex-oauth.sh\" ensure-daemon",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
